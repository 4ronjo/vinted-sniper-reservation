# Copy to .checkout.env and keep both this configuration and browser cookies private.
# Supply to Compose using --env-file .checkout.env (not the sniper's .env).
SNIPER_VNC_PASSWORD=REPLACE_WITH_A_STRONG_PRIVATE_VNC_PASSWORD
SNIPER_CHECKOUT_VIEW_URL=http://localhost:7900/vnc.html?autoconnect=1&resize=scale

SNIPER_CHECKOUT_WEBHOOK_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_24_CHARS
SNIPER_CHECKOUT_DRY_RUN=true
SNIPER_CHECKOUT_QUEUE_SIZE=10
SNIPER_CHECKOUT_EMAIL_TO=theorieofgaming@gmail.com
SNIPER_SMTP_USER=
SNIPER_SMTP_APP_PASSWORD=
SNIPER_SMTP_HOST=smtp.gmail.com
SNIPER_SMTP_PORT=465
SNIPER_SELENIUM_URL=http://browser:4444/wd/hub
SNIPER_VINTED_HOME=https://www.vinted.de

# Only if you have verified these selectors on your own Vinted checkout page.
# Without READY_CSS, email correctly reports checkout URL as UNVERIFIED.
# Do not guess or use broad selectors like body/html.
SNIPER_CHECKOUT_READY_CSS=
SNIPER_CHECKOUT_ERROR_CSS=
